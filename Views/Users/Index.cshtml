@model List<HumanBirthPredictionSystem.Models.User>
@{
    ViewData["Title"] = "User Management";
    ViewData["Subtitle"] = "Manage administrative and standard user accounts and permissions";
}

<div class="filter-bar">
    <div style="flex:1;">
        <span class="text-soft">Total Users Registered: <strong>@Model.Count</strong></span>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add New User</a>
</div>

<div class="card" style="margin-bottom:20px; background:linear-gradient(135deg, rgba(37,99,235,0.04), rgba(124,58,237,0.04)); border:1px solid rgba(99,102,241,0.2);">
    <div style="padding:16px 20px; display:flex; gap:16px; align-items:center;">
        <div style="width:40px; height:40px; border-radius:10px; background:#4338ca; display:flex; align-items:center; justify-content:center; color:#fff; font-weight:700;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div style="flex:1;">
            <h4 style="margin:0 0 4px 0; font-size:15px; color:#1e293b;">Role-Based Access Control (RBAC)</h4>
            <p style="margin:0; font-size:13px; color:#64748b;">
                <strong>Admin:</strong> Full permissions (User Management, Countries, Cities, Edit/Delete Records).<br/>
                <strong>User:</strong> Data Entry &amp; Viewer role. Can log in, explore dashboards, run predictions, export reports, and submit new birth records, but <em>strictly cannot edit, delete, or alter existing system data</em>.
            </p>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Full Name</th>
                    <th>Assigned Role</th>
                    <th>Permissions</th>
                    <th>Created</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6"><div class="empty-state"><h4>No users found</h4><p>Create an account to grant access to the system.</p></div></td></tr>
            }
            @foreach (var u in Model)
            {
                var isAdmin = (u.Role ?? "Admin").Equals("Admin", StringComparison.OrdinalIgnoreCase);
                var isCurrent = User.Identity?.Name?.Equals(u.Username, StringComparison.OrdinalIgnoreCase) == true;
                <tr>
                    <td>
                        <strong>@u.Username</strong>
                        @if (isCurrent)
                        {
                            <span style="font-size:11px; margin-left:6px; padding:2px 6px; border-radius:4px; background:#e0f2fe; color:#0369a1; font-weight:600;">You</span>
                        }
                    </td>
                    <td>@u.FullName</td>
                    <td>
                        @if (isAdmin)
                        {
                            <span class="badge" style="background:#fef3c7; color:#92400e; font-weight:600; border:1px solid #fde68a;">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right:3px; vertical-align:-1px;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                Administrator
                            </span>
                        }
                        else
                        {
                            <span class="badge" style="background:#e0e7ff; color:#3730a3; font-weight:600; border:1px solid #c7d2fe;">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right:3px; vertical-align:-1px;"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                Standard User
                            </span>
                        }
                    </td>
                    <td>
                        @if (isAdmin)
                        {
                            <span style="font-size:12px; color:#059669; font-weight:500;">✓ Full System &amp; Data Control</span>
                        }
                        else
                        {
                            <span style="font-size:12px; color:#475569; font-weight:500;">✓ Data Entry &amp; View Only (No Edit/Delete)</span>
                        }
                    </td>
                    <td class="text-soft">@u.CreatedAt.ToString("MMM d, yyyy")</td>
                    <td style="text-align:right;">
                        <div class="actions-row" style="justify-content:flex-end;">
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline btn-sm">Edit</a>
                            @if (!isCurrent)
                            {
                                <form asp-action="Delete" asp-route-id="@u.Id" method="post" onsubmit="return confirm('Are you sure you want to delete user \'@u.Username\'?');" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
